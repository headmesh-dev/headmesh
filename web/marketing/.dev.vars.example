# Copy to .dev.vars for `pnpm pages:dev` (wrangler pages dev). .dev.vars is git-ignored.
# Cloudflare's "always passes" Turnstile test secret; pairs with the default test site key in local builds.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Generate with: openssl rand -base64 48
WAITLIST_SECRET=
# Log confirmation links instead of sending email. Set to "resend" and add RESEND_API_KEY to send for real.
EMAIL_DELIVERY=log
RESEND_API_KEY=
SITE_URL=
