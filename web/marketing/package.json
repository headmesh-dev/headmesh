{
  "name": "@headmesh/marketing",
  "version": "0.0.0",
  "private": true,
  "description": "headmesh.dev: static marketing site and docs (Astro + Starlight), plus the waitlist service (Node + SQLite)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "files": [
    "server",
    "shared",
    "migrations",
    "!server/tsconfig.json"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "serve": "node --env-file-if-exists=.env server/main.ts",
    "check": "astro check && tsc -p server/tsconfig.json",
    "lint": "biome check . && pnpm run check",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "resend": "6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "astro": "^7.4.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
