---
/**
 * The "headmesh" wordmark: Bricolage Grotesque ExtraBold, tracking -2.5%, outlined to a path so it never depends
 * on font loading. Fills with currentColor. Generated by the brand kit (gen/textpath.py).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 445.4 71.4" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="$D"></path>
</svg>
