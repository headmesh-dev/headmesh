# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# These apply to static assets only; the Functions under /api set their own headers.
#
# {{SCRIPT_HASHES}} and {{STYLE_HASHES}} are replaced after `astro build` by scripts/csp.mjs with the SHA-256
# hashes of every inline <script> and <style> in dist/; the build fails if a placeholder survives or an inline
# event handler appears. Scripts and <style> elements are hash-only. Inline style *attributes* are allowed
# (style-src-attr) because Starlight and Expressive Code set CSS custom properties that way; attributes can't load
# anything (img-src/font-src are 'self') and can't run script.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' {{SCRIPT_HASHES}} https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' {{STYLE_HASHES}}; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The production site is also reachable on its pages.dev hostname; keep that copy out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
