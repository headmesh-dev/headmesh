---
import { CONTACT_EMAIL } from "../../../shared/site";
import TokenAction from "../../components/TokenAction.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="Confirm your email"
  description="Confirm your place on the Headmesh waitlist."
  ogImage="waitlist"
  noindex
>
  <section class="container-page pt-16 sm:pt-24">
    <p class="eyebrow">Waitlist</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Confirm your email</h1>
    <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
      One click and you're on the Headmesh waitlist. We'll email you when early access opens.
    </p>
    <TokenAction
      endpoint="/api/waitlist/confirm"
      action="Confirm my email"
      success="You're on the list. Thanks! We'll be in touch when early access opens."
      invalid="This link is invalid or has expired. Join the waitlist again to get a new one."
      failed={`Something went wrong. Please try again, or email ${CONTACT_EMAIL}.`}
      missing="This page needs the link from your confirmation email. Open the link from the email again."
    />
  </section>
</Base>
