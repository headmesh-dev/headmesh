---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import { CONSENT_TEXT, CONSENT_VERSION, CONTACT_EMAIL, LIMITS, SENDER, TURNSTILE_ACTION } from "../../shared/site";
import Base from "../layouts/Base.astro";

const senderLine = [SENDER.legalName, SENDER.postalAddress].filter(Boolean).join(", ");
---

<Base
  title="Join the waitlist"
  description="Get early access to Headmesh, the open, self-hostable, multi-tenant mesh for machines you share."
  ogImage="waitlist"
>
  <section class="container-page grid gap-12 pt-16 sm:pt-24 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <p class="eyebrow">Early access</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">Join the waitlist</h1>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
        Headmesh is in early development. Leave your email and we'll invite you as soon as there's something to try.
        Tell us what you'd use it for and we'll prioritise it.
      </p>
      <ul class="mt-8 space-y-3 text-muted">
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">→</span>No spam: early-access invites and the occasional update.</li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">→</span>You confirm by email first, and every message has a one-click unsubscribe.</li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">→</span>We never sell or share your email.</li>
      </ul>
    </div>

    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <form id="waitlist-form" method="post" action="/api/waitlist" class="space-y-6" data-waitlist-form>
        <div>
          <label for="email" class="block text-sm font-semibold">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            maxlength={LIMITS.email}
            class="mt-2 block w-full rounded-lg border border-line bg-raised px-3.5 py-2.5 text-fg placeholder:text-muted/70 focus:border-accent focus:outline-none"
            placeholder="you@example.com"
            aria-describedby="email-error"
          />
          <p id="email-error" class="mt-1.5 hidden text-sm text-danger" data-error-for="email"></p>
        </div>

        <div>
          <label for="use_case" class="block text-sm font-semibold">
            What would you use Headmesh for? <span class="font-normal text-muted">(optional)</span>
          </label>
          <textarea
            id="use_case"
            name="use_case"
            rows="4"
            maxlength={LIMITS.useCase}
            class="mt-2 block w-full resize-y rounded-lg border border-line bg-raised px-3.5 py-2.5 text-fg placeholder:text-muted/70 focus:border-accent focus:outline-none"
            placeholder="Sharing GPUs with renters, giving AI agents access to a home lab, connecting client sites…"
            aria-describedby="use_case-error"></textarea>
          <p id="use_case-error" class="mt-1.5 hidden text-sm text-danger" data-error-for="use_case"></p>
        </div>

        <div>
          <div class="flex gap-3">
            <input
              id="consent"
              name="consent"
              type="checkbox"
              required
              class="mt-1 size-4 shrink-0 accent-accent"
              aria-describedby="consent-sender consent-error"
            />
            <label for="consent" class="text-sm leading-relaxed">{CONSENT_TEXT}</label>
          </div>
          <p id="consent-error" class="mt-1.5 hidden text-sm text-danger" data-error-for="consent"></p>
          <p id="consent-sender" class="mt-3 text-xs leading-relaxed text-muted">
            Consent is requested by {senderLine} (<a class="underline underline-offset-2" href={`mailto:${CONTACT_EMAIL}`}
              >{CONTACT_EMAIL}</a
            >). We'll send a confirmation email first. You can withdraw consent at any time with the unsubscribe link in
            every email or by writing to us. See the <a class="underline underline-offset-2" href="/privacy/">privacy policy</a>.
          </p>
        </div>

        <input type="hidden" name="consent_version" value={CONSENT_VERSION} />

        <div
          class="cf-turnstile min-h-[65px]"
          data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
          data-action={TURNSTILE_ACTION}
          data-theme="auto"
          data-size="flexible"
        >
        </div>

        <div>
          <button type="submit" class="btn btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60" disabled>
            Join the waitlist
          </button>
          <noscript>
            <p class="mt-3 text-sm text-muted">
              The form needs JavaScript for spam protection. You can also email <a
                class="underline"
                href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
              > to join.
            </p>
          </noscript>
        </div>

        <p role="status" aria-live="polite" class="text-sm empty:hidden" data-form-status></p>
      </form>

      <div class="hidden" data-waitlist-success tabindex="-1">
        <h2 class="text-2xl font-bold tracking-tight">Check your inbox</h2>
        <p class="mt-3 leading-relaxed text-muted">
          We've sent a confirmation link to <strong class="text-fg" data-success-email></strong>. Open it to confirm your
          spot. If it hasn't arrived in a few minutes, check your spam folder.
        </p>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { initWaitlistForm } from "../scripts/waitlist";

    initWaitlistForm();
  </script>
</Base>
