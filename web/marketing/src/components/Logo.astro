---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const gradientId = `hm-leg-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class={className}
  viewBox="76 76 360 360"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="222" y1="280" x2="290" y2="424">
      <stop offset="0" class="hm-stop-a"></stop>
      <stop offset="1" class="hm-stop-b"></stop>
    </linearGradient>
  </defs>
  <g fill="currentColor">
    <path d="M88 390V122a34 34 0 0 1 68 0v268a34 34 0 0 1-68 0Z"></path>
    <path d="M356 390V122a34 34 0 0 1 68 0v268a34 34 0 0 1-68 0Z"></path>
    <path d="M88 280a101 101 0 0 1 202 0h-68a33 33 0 0 0-66 0Z"></path>
    <path d="M222 280a101 101 0 0 1 202 0h-68a33 33 0 0 0-66 0Z"></path>
  </g>
  <path fill={`url(#${gradientId})`} d="M222 280h68v110a34 34 0 0 1-68 0Z"></path>
</svg>
