---
import { CONTACT_EMAIL, REPO_URL, SENDER } from "../../shared/site";
import Logo from "./Logo.astro";

const year = new Date().getUTCFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-page flex flex-col gap-8 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-sm">
      <a href="/" class="flex items-center gap-2 font-semibold" aria-label="Headmesh home">
        <Logo class="size-6 text-accent" />
        <span>Headmesh</span>
      </a>
      <p class="mt-3 text-sm text-muted">
        Open, self-hostable, multi-tenant networking built on Headscale and WireGuard.
      </p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm sm:grid-cols-3">
      <a class="text-muted hover:text-fg" href="/docs/">Docs</a>
      <a class="text-muted hover:text-fg" href={REPO_URL}>GitHub</a>
      <a class="text-muted hover:text-fg" href="/waitlist/">Waitlist</a>
      <a class="text-muted hover:text-fg" href="/privacy/">Privacy</a>
      <a class="text-muted hover:text-fg" href="/terms/">Terms</a>
      <a class="text-muted hover:text-fg" href="/.well-known/security.txt">Security</a>
      <a class="text-muted hover:text-fg" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
  </div>
  <div class="container-page border-t border-line/60 py-6 text-xs text-muted">
    <p>
      © {year} {SENDER.legalName} Headmesh is not affiliated with Tailscale Inc. or the Headscale project.
      WireGuard is a registered trademark of Jason A. Donenfeld.
    </p>
  </div>
</footer>
