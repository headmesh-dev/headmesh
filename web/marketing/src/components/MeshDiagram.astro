---
// Hero illustration: one owner workspace shares exactly one machine with a renter (time-limited) and one with
// an AI agent sandbox, while everything else stays private.
---

<svg
  viewBox="0 0 520 340"
  class="h-auto w-full font-mono"
  role="img"
  aria-labelledby="mesh-diagram-title"
>
  <title id="mesh-diagram-title">
    Diagram: a renter holds a four-hour grant to one GPU in your workspace, an AI agent sandbox reaches only your
    NAS, and your desktop stays private.
  </title>

  <!-- Workspaces -->
  <rect x="8" y="8" width="208" height="324" rx="14" class="fill-surface stroke-line" stroke-width="1.5"></rect>
  <text x="28" y="38" class="fill-muted" font-size="11" letter-spacing="1.2">YOUR WORKSPACE</text>

  <rect x="312" y="8" width="200" height="150" rx="14" class="fill-surface stroke-line" stroke-width="1.5"></rect>
  <text x="332" y="38" class="fill-muted" font-size="11" letter-spacing="1.2">RENTER</text>
  <text x="332" y="134" class="fill-muted" font-size="11">sees gpu-01 only</text>

  <rect x="312" y="182" width="200" height="150" rx="14" class="fill-surface stroke-line" stroke-width="1.5"></rect>
  <text x="332" y="212" class="fill-muted" font-size="11" letter-spacing="1.2">AI AGENT</text>
  <text x="332" y="308" class="fill-muted" font-size="11">scoped mode</text>

  <!-- Grants -->
  <g class="stroke-accent" stroke-width="1.75" stroke-dasharray="5 5" fill="none">
    <path d="M332 84H196"></path>
    <path d="M332 258H264V166H196"></path>
  </g>
  <g class="fill-accent">
    <circle cx="196" cy="84" r="3.5"></circle>
    <circle cx="332" cy="84" r="3.5"></circle>
    <circle cx="196" cy="166" r="3.5"></circle>
    <circle cx="332" cy="258" r="3.5"></circle>
  </g>
  <text x="264" y="74" text-anchor="middle" class="fill-accent" font-size="11">grant · 4h</text>
  <text x="258" y="216" text-anchor="end" class="fill-accent" font-size="11">scoped</text>

  <!-- Devices -->
  <g font-size="13">
    <rect x="28" y="64" width="168" height="40" rx="8" class="fill-raised stroke-line" stroke-width="1.5"></rect>
    <circle cx="46" cy="84" r="4" class="fill-accent"></circle>
    <text x="60" y="88.5" class="fill-fg">gpu-01</text>

    <rect x="28" y="146" width="168" height="40" rx="8" class="fill-raised stroke-line" stroke-width="1.5"></rect>
    <circle cx="46" cy="166" r="4" class="fill-accent"></circle>
    <text x="60" y="170.5" class="fill-fg">nas</text>

    <rect x="28" y="228" width="168" height="40" rx="8" class="fill-raised stroke-line" stroke-width="1.5"></rect>
    <circle cx="46" cy="248" r="4" class="fill-muted"></circle>
    <text x="60" y="252.5" class="fill-fg">desktop</text>
    <text x="184" y="252" text-anchor="end" class="fill-muted" font-size="10.5">private</text>

    <rect x="332" y="64" width="160" height="40" rx="8" class="fill-raised stroke-line" stroke-width="1.5"></rect>
    <circle cx="350" cy="84" r="4" class="fill-accent"></circle>
    <text x="364" y="88.5" class="fill-fg">laptop</text>

    <rect x="332" y="238" width="160" height="40" rx="8" class="fill-raised stroke-line" stroke-width="1.5"></rect>
    <circle cx="350" cy="258" r="4" class="fill-accent"></circle>
    <text x="364" y="262.5" class="fill-fg">sandbox</text>
  </g>
</svg>
