# Copy to .env for `pnpm serve` (the waitlist service on http://127.0.0.1:8787). .env is git-ignored.
# Astro's own build settings (PUBLIC_*) can live in the same file.
WAITLIST_DB_PATH=./.waitlist.db
SITE_URL=http://localhost:4321
EMAIL_FROM=Headmesh <waitlist@mail.headmesh.dev>
# Log confirmation links instead of sending email. Set to "resend" and add RESEND_API_KEY to send for real.
EMAIL_DELIVERY=log
# Required when EMAIL_DELIVERY=resend. Use a sending-only key and a published template ID or alias.
RESEND_API_KEY=
RESEND_CONFIRMATION_TEMPLATE_ID=
# Cloudflare's "always passes" Turnstile test secret; pairs with the test site key the build uses by default.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Generate with: openssl rand -base64 48
WAITLIST_SECRET=
