# headmesh.dev waitlist service (prod), web/marketing/server/config.ts. Copy to waitlist.env (git-ignored), or run
# `deploy/deploy.sh --env prod --init-env`, which also generates WAITLIST_SECRET. Every deploy uploads this file and
# replaces the server's copy. WAITLIST_HOST, WAITLIST_PORT and WAITLIST_DB_PATH are set per instance by deployctl.
NODE_ENV=production
SITE_URL=https://headmesh.dev
EMAIL_FROM=Headmesh <waitlist@mail.headmesh.dev>
EMAIL_REPLY_TO=hello@headmesh.dev
EMAIL_DELIVERY=resend
# Resend API key restricted to sending from mail.headmesh.dev.
RESEND_API_KEY=CHANGE_ME
# Published confirmation template ID or alias; all three URL variables are supplied by the service.
RESEND_CONFIRMATION_TEMPLATE_ID=CHANGE_ME
# The Turnstile widget's secret key (pairs with PUBLIC_TURNSTILE_SITE_KEY in build.env).
TURNSTILE_SECRET_KEY=CHANGE_ME
# At least 32 random characters (openssl rand -base64 48). Rotating it voids outstanding confirmation links.
WAITLIST_SECRET=CHANGE_ME
