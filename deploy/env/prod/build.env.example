# Build-time settings for the headmesh.dev site (prod). Copy to build.env (git-ignored); deploy.sh sources it before
# `pnpm build`. The production build refuses to run without the real Turnstile site key, and without the CASL postal
# address in web/marketing/shared/site.ts.
PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME
# Cloudflare Web Analytics site token. Leave empty to ship no analytics beacon.
PUBLIC_CF_ANALYTICS_TOKEN=
