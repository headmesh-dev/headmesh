# headmesh-server (prod), cmd/headmesh-server/config.go. Copy to backend.env (git-ignored). Every deploy uploads it
# and replaces the server's copy. The database URL, signing key, cell CA, TLS files and listen addresses are set on
# the server (db.env, secrets.env and the per-instance file deployctl writes); don't put them here.
HEADMESH_PUBLIC_URL=https://api.headmesh.dev
HEADMESH_INSTALL_URL=https://get.headmesh.dev
HEADMESH_LOG_LEVEL=info
