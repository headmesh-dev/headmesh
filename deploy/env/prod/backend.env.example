# headmesh-server (prod), cmd/headmesh-server/config.go. Copy to backend.env (git-ignored). Every deploy uploads it
# and replaces the server's copy. The database URL, signing key, cell CA, TLS files and listen addresses are set on
# the server (db.env, secrets.env and the per-instance file deployctl writes); don't put them here.
HEADMESH_PUBLIC_URL=https://api.headmesh.dev
HEADMESH_INSTALL_URL=https://get.headmesh.dev
HEADMESH_LOG_LEVEL=info

# Browser sign-in callbacks: /oauth/callback/github and /oauth/callback/huggingface
# below HEADMESH_PUBLIC_URL. Secret files must be 0600 and readable by the service.
HEADMESH_GITHUB_CLIENT_ID=
HEADMESH_GITHUB_CLIENT_SECRET_FILE=
HEADMESH_HF_LOGIN_ENABLED=false
# Empty HF client ID uses /.well-known/oauth-cimd with public PKCE registration.
HEADMESH_HF_CLIENT_ID=
HEADMESH_HF_CLIENT_SECRET_FILE=

# MCP authorization server: distinct, private, base64-encoded 32-byte files.
# Sandbox access still requires an explicit operator oauth-grant.
HEADMESH_OAUTH_ENABLED=false
HEADMESH_OAUTH_SIGNING_KEY_FILE=
HEADMESH_OAUTH_CRYPTO_KEY_FILE=
