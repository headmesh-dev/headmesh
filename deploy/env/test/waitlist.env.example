# test.headmesh.dev waitlist service. Copy to waitlist.env (git-ignored), or run
# `deploy/deploy.sh --env test --init-env`, which also generates WAITLIST_SECRET. Email links go to the journal
# (`journalctl -u 'headmesh-waitlist@test-*'`) instead of being sent, so a public test site can't send mail.
NODE_ENV=production
SITE_URL=https://test.headmesh.dev
EMAIL_FROM=Headmesh test <waitlist-test@mail.headmesh.dev>
EMAIL_DELIVERY=log
# Required only when deliberately switching this environment to real Resend delivery.
RESEND_API_KEY=
RESEND_CONFIRMATION_TEMPLATE_ID=
# Cloudflare's always-pass Turnstile test secret; pairs with the build's default test site key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
WAITLIST_SECRET=CHANGE_ME
