# This machine's deploy settings. Copy to local.env (git-ignored); deploy.sh reads it, and the environment
# overrides it. Addresses live here rather than in the repository.
# SSH destination: hm-prod-1 over the tailnet.
HM_DEPLOY_HOST=aaryn@<tailnet IP>
# The host key was first saved under the public address; the tailnet and break-glass addresses present the same key.
HM_DEPLOY_HOST_KEY_ALIAS=<public IPv4>
# Break-glass WireGuard address, for when the tailnet is down (deploy/breakglass/).
HM_DEPLOY_BREAKGLASS_HOST=aaryn@<break-glass IP>
HM_DEPLOY_IDENTITY=/home/<you>/.ssh/hm-prod-1
