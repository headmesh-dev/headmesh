
# The {{ENV}} environment's Headscale cell ({{CELL_HOST}}). Rendered into site.conf.tmpl only when the environment hosts a
# cell. The name must be DNS-only in Cloudflare: Tailscale's control protocol (/ts2021) and DERP upgrade the
# connection, which Cloudflare's proxy can't carry. Headscale listens on loopback; its gRPC API is never proxied.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{CELL_HOST}};
    include /etc/nginx/snippets/headmesh-tls.conf;
    access_log /var/log/nginx/headmesh-{{ENV}}-cell.log headmesh_json;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    {{NOINDEX_HEADER}}

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $headmesh_connection_upgrade;
        proxy_buffering off;
        proxy_redirect off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
