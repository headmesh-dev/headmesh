# Authenticated sandbox MCP ingress. Render placeholders from private ops
# inventory; the upstream is a sandbox's own tailnet address, never the host.
server {
    listen 80;
    listen [::]:80;
    server_name __SANDBOX_HOST__;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SANDBOX_HOST__;
    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    location = /privacy { return 302 https://headmesh.dev/privacy; }
    location = /terms { return 302 https://headmesh.dev/terms; }

    # The portal-issued token is public verification material. Keep the file
    # absent until OpenAI issues it, then install its exact bytes here.
    location = /.well-known/openai-apps-challenge {
        alias /etc/headmesh/sandbox/openai-apps-challenge;
        default_type text/plain;
        add_header Cache-Control no-store always;
    }

    # The sandbox verifies every bearer token and scope. No token is embedded
    # here, and the edge never turns anonymous requests into authenticated ones.
    location / {
        proxy_pass http://__SANDBOX_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 120s;
    }
}
