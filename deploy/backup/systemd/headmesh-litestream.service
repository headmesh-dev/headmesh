[Unit]
Description=Replicate the hs1 Headscale database to object storage
After=network-online.target headscale.service
Wants=network-online.target

[Service]
Type=simple
User=headscale
Group=headscale
WorkingDirectory=/var/lib/headscale
EnvironmentFile=/etc/headmesh/backup/litestream.env
LoadCredential=r2-credentials:/etc/headmesh/backup/litestream.aws
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/r2-credentials
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStartPre=/usr/bin/test -s /var/lib/headscale/db.sqlite
ExecStartPre=/usr/bin/test -n ${HEADMESH_R2_ENDPOINT}
ExecStart=/usr/bin/litestream replicate -config /etc/headmesh/backup/litestream.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/headscale
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
