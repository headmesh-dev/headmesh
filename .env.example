# Workstation operator credentials. Copy to .env and fill only what your tools need.
# This root file is not loaded by the application or deploy.sh.
# Marketing development: web/marketing/.env.example -> web/marketing/.env
# Deployment: deploy/env/{test,prod}/{build,waitlist,backend}.env.example
# SSH/deploy settings: deploy/env/local.env.example -> deploy/env/local.env
# Keep real values in git-ignored files; do not copy operator tokens into service envs.

# npm package publishing credentials for the Headmesh scope.
NPM_ACCESS_TOKEN=

# Infrastructure provisioning credentials for local operator tools.
HETZNER_API_TOKEN=
UBUNTU_PRO_TOKEN=

# Temporary full-access "Agent setup" key for Resend domain/key configuration.
# The app uses a separate sending-only RESEND_API_KEY in deploy/env/prod/waitlist.env.
RESEND_SETUP_API_KEY=
