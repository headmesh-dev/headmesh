#!/usr/bin/env bash
# headmesh-sandbox-firewall — host egress firewall for the Headmesh agent sandbox (plan §6.5).
#
# Installs the native nftables table `inet headmesh_sbx`. Its input and forward
# chains hook at priority `filter - 10`, so they run BEFORE the iptables-nft
# chains Docker, ufw, tailscaled-xcelsior and Xcelsior's egress guard manage in
# `table ip filter` (priority 0). A drop here is final; an accept here only ends
# this table, so every existing rule still applies afterwards. The table never
# edits another tool's chain.
#
# Why it must run first: a host may accept forwarded traffic to its tailnet
# interface ahead of DOCKER-USER. Without this table a bridge container could then
# reach 100.64.0.0/10 masqueraded as the host's own tailnet node, plus any host
# service open to Docker bridges.
#
# For traffic from the sandbox bridge (SBX_BRIDGE):
#   to the host itself (any local address)     drop, except replies
#   to other containers on the bridge          drop
#   UDP TS_UDP_PORTS to private LAN ranges      allow (direct WireGuard paths)
#   ALLOW_DNS_TO port 53                        allow (empty by default)
#   YOLO_ALLOW_LAN=1, from SBX_YOLO_IP only     allow the host's LAN subnets
#   private, CGNAT, link-local, reserved        drop (log, rate-limited)
#   everything else (the internet)              allow
#
# Usage: headmesh-sandbox-firewall apply|ensure|remove|status|render|check [--docker IMAGE]
set -euo pipefail

TABLE=headmesh_sbx
CONF=${HEADMESH_SANDBOX_FIREWALL_CONF:-/etc/headmesh/sandbox-firewall.conf}
STATUS_FILE=${HEADMESH_SANDBOX_FIREWALL_STATUS:-/run/headmesh-sandbox-firewall.json}

SBX_BRIDGE=br-hm-sbx0
SBX_SUBNET=172.31.250.0/24
SBX_REGULAR_IP=172.31.250.10
SBX_YOLO_IP=172.31.250.11
YOLO_ALLOW_LAN=0
TS_UDP_PORTS=41641-41650
ALLOW_DNS_TO=""
LAN_SUBNETS=""
LOG_PREFIX="HM-SBX-DROP "

die() { echo "headmesh-sandbox-firewall: $*" >&2; exit 1; }
warn() { echo "headmesh-sandbox-firewall: warning: $*" >&2; }

load_conf() {
    if [ -e "$CONF" ]; then
        # The file is sourced, so it must not be writable by anyone but root.
        if [ "$(id -u)" = 0 ]; then
            local owner mode
            owner=$(stat -c %u "$CONF")
            mode=$(stat -c %a "$CONF")
            [ "$owner" = 0 ] || die "$CONF must be owned by root"
            case "$mode" in *[2367]?|*[2367]) die "$CONF must not be group- or world-writable (mode $mode)" ;; esac
        fi
        # shellcheck source=/dev/null
        . "$CONF"
    fi
    validate
}

ipv4_re='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
cidr4_re='^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'

validate() {
    [[ $SBX_BRIDGE =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || die "SBX_BRIDGE: invalid interface name '$SBX_BRIDGE'"
    [[ $SBX_SUBNET =~ $cidr4_re ]] || die "SBX_SUBNET: not an IPv4 CIDR: '$SBX_SUBNET'"
    [[ $SBX_REGULAR_IP =~ $ipv4_re ]] || die "SBX_REGULAR_IP: not an IPv4 address: '$SBX_REGULAR_IP'"
    [[ $SBX_YOLO_IP =~ $ipv4_re ]] || die "SBX_YOLO_IP: not an IPv4 address: '$SBX_YOLO_IP'"
    [[ $YOLO_ALLOW_LAN =~ ^[01]$ ]] || die "YOLO_ALLOW_LAN must be 0 or 1"
    [[ $TS_UDP_PORTS =~ ^[0-9]{1,5}(-[0-9]{1,5})?$ ]] || die "TS_UDP_PORTS: expected PORT or LOW-HIGH"
    local a
    for a in $ALLOW_DNS_TO; do [[ $a =~ $ipv4_re ]] || die "ALLOW_DNS_TO: not an IPv4 address: '$a'"; done
    for a in $LAN_SUBNETS; do [[ $a =~ $cidr4_re ]] || die "LAN_SUBNETS: not an IPv4 CIDR: '$a'"; done
    [[ $LOG_PREFIX =~ ^[A-Za-z0-9\ _:.-]{0,30}$ ]] || die "LOG_PREFIX: only letters, digits, space and _:.- (max 30)"
}

# LAN subnets = kernel link routes on physical interfaces (wired, Wi-Fi). Docker
# bridges, veths, tailscale, WireGuard and the sandbox bridge are excluded.
detect_lan_subnets() {
    ip -4 -o route show proto kernel scope link 2>/dev/null | awk -v sbx="$SBX_BRIDGE" '
        { dst = $1; dev = "" ; for (i = 1; i < NF; i++) if ($i == "dev") dev = $(i + 1) }
        dev == "" || dev == sbx { next }
        dev ~ /^(docker|br-|veth|tailscale|ts|wg|hm|xcl-|virbr|lxc|cni|flannel|vxlan|podman)/ { next }
        dst ~ /\// { print dst }' | sort -u | tr '\n' ' '
}

join_csv() { local IFS=,; echo "$*"; }

log_stmt() {
    if [ -n "$LOG_PREFIX" ]; then
        printf 'limit rate 10/minute burst 5 packets log prefix "%s" level warn' "$LOG_PREFIX"
    fi
}

render() {
    local lan dns_set yolo_set logs
    lan=${LAN_SUBNETS:-$(detect_lan_subnets)}
    logs=$(log_stmt)
    # shellcheck disable=SC2086
    set -- $lan
    local lan_csv
    lan_csv=$(join_csv 10.0.0.0/8 192.168.0.0/16 "$@")
    cat <<EOF
#!/usr/sbin/nft -f
# Generated by headmesh-sandbox-firewall from $CONF — edit that file, not this output.
# bridge=$SBX_BRIDGE subnet=$SBX_SUBNET regular=$SBX_REGULAR_IP yolo=$SBX_YOLO_IP yolo_allow_lan=$YOLO_ALLOW_LAN lan=[${lan% }]
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	comment "headmesh sandbox egress firewall; managed by headmesh-sandbox-firewall"

	# Never reachable from the sandbox bridge (outside the tailnet, which runs
	# inside the container over its own tun device).
	set blocked4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
			     172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15,
			     198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
	}

	# fc00::/7 includes Tailscale's ULA fd7a:115c:a1e0::/48.
	set blocked6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b:1::/48, 100::/64,
			     2001:db8::/32, fc00::/7, fe80::/10, ff00::/8 }
	}

	# Private ranges where Tailscale peers may answer on TS_UDP_PORTS.
	set lan_udp4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { $lan_csv }
	}
EOF
    if [ -n "$ALLOW_DNS_TO" ]; then
        # shellcheck disable=SC2086
        dns_set=$(join_csv $ALLOW_DNS_TO)
        cat <<EOF

	set dns4 {
		type ipv4_addr
		elements = { $dns_set }
	}
EOF
    fi
    if [ "$YOLO_ALLOW_LAN" = 1 ] && [ -n "$lan" ]; then
        # shellcheck disable=SC2086
        yolo_set=$(join_csv $lan)
        cat <<EOF

	set yolo_lan4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { $yolo_set }
	}
EOF
    fi
    cat <<EOF

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname "$SBX_BRIDGE" jump sbx_to_host
	}

	# Packets from the bridge addressed to the host itself (gateway, LAN IPs,
	# tailscale0, other bridges' gateways). Only replies to connections the
	# host opened are let through.
	chain sbx_to_host {
		ct state established,related accept
		$logs
		counter drop comment "sandbox -> host"
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "$SBX_BRIDGE" jump sbx_out
	}

	chain sbx_out {
		ct state established,related accept
		ct state invalid counter drop
		oifname "$SBX_BRIDGE" counter drop comment "container -> container"
EOF
    if [ -n "$ALLOW_DNS_TO" ]; then
        printf '\t\tip daddr @dns4 meta l4proto { tcp, udp } th dport 53 counter accept comment "ALLOW_DNS_TO"\n'
    fi
    if [ "$YOLO_ALLOW_LAN" = 1 ] && [ -n "$lan" ]; then
        printf '\t\tip saddr %s ip daddr @yolo_lan4 counter accept comment "YOLO_ALLOW_LAN"\n' "$SBX_YOLO_IP"
    fi
    cat <<EOF
		ip daddr @lan_udp4 udp dport $TS_UDP_PORTS counter accept comment "tailscale direct paths"
		ip daddr @blocked4 $logs
		ip daddr @blocked4 counter drop comment "private/reserved v4"
		ip6 daddr @blocked6 $logs
		ip6 daddr @blocked6 counter drop comment "private/reserved v6"
		counter comment "internet"
	}
}
EOF
}

need_root() { [ "$(id -u)" = 0 ] || die "$1 needs root (run with sudo)"; }

ruleset_hash() { render | grep -v '^# Generated' | sha256sum | cut -c1-16; }

write_status() {
    local applied=$1 hash=$2
    umask 022
    printf '{"table":"inet %s","applied":%s,"hash":"%s","bridge":"%s","subnet":"%s","yolo_allow_lan":%s,"updated_at":"%s"}\n' \
        "$TABLE" "$applied" "$hash" "$SBX_BRIDGE" "$SBX_SUBNET" "$YOLO_ALLOW_LAN" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        >"$STATUS_FILE.tmp" && mv "$STATUS_FILE.tmp" "$STATUS_FILE"
}

current_hash() {
    nft list table inet "$TABLE" 2>/dev/null | sed -n 's/.*headmesh-sandbox-firewall hash=\([0-9a-f]*\).*/\1/p' | head -1
}

apply() {
    need_root apply
    command -v nft >/dev/null || die "nft not found (apt install nftables)"
    local tmp hash
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' RETURN
    hash=$(ruleset_hash)
    render | sed "s|managed by headmesh-sandbox-firewall\"|managed by headmesh-sandbox-firewall hash=$hash\"|" >"$tmp"
    nft -c -f "$tmp" || die "ruleset failed validation; nothing changed"
    nft -f "$tmp"
    write_status true "$hash"
    echo "applied table inet $TABLE (hash $hash)"
    check_iptables_path || true
}

ensure() {
    need_root ensure
    if [ "$(current_hash)" != "$(ruleset_hash)" ]; then
        apply
    fi
}

remove() {
    need_root remove
    if nft list table inet "$TABLE" >/dev/null 2>&1; then
        nft delete table inet "$TABLE"
        echo "removed table inet $TABLE"
    fi
    write_status false ""
}

# The iptables side must still ACCEPT the bridge, or the sandbox has no egress
# at all. On this host DOCKER-USER (restored by netfilter-persistent) ends with
# a DROP and only RETURNs for lo, tailscale0, docker0 and br+.
check_iptables_path() {
    command -v iptables >/dev/null || return 0
    local rules
    rules=$(iptables -S DOCKER-USER 2>/dev/null) || return 0
    if ! grep -qE -- '^-A DOCKER-USER( .*)? -j DROP$' <<<"$rules"; then
        return 0
    fi
    if grep -qE -- "^-A DOCKER-USER -i ($SBX_BRIDGE|br\\+) -j RETURN$" <<<"$rules"; then
        return 0
    fi
    case "$SBX_BRIDGE" in
        br*) grep -qE -- '^-A DOCKER-USER -i br\+ -j RETURN$' <<<"$rules" && return 0 ;;
    esac
    warn "DOCKER-USER ends in DROP and has no RETURN for $SBX_BRIDGE: the sandbox has no egress."
    warn "Rename the bridge to match br+ (preferred) or add: iptables -I DOCKER-USER <n> -i $SBX_BRIDGE -j RETURN before the DROP."
    return 1
}

status() {
    need_root status
    local rc=0 hash want
    if nft list table inet "$TABLE" >/dev/null 2>&1; then
        hash=$(current_hash)
        want=$(ruleset_hash)
        echo "table inet $TABLE: present (hash ${hash:-?}, config hash $want)"
        [ "$hash" = "$want" ] || { warn "loaded rules differ from $CONF; run: headmesh-sandbox-firewall apply"; rc=4; }
        nft list table inet "$TABLE" | grep -E 'counter packets [1-9]' | sed 's/^\s*/  /' || true
    else
        echo "table inet $TABLE: MISSING"
        rc=3
    fi
    if ip link show "$SBX_BRIDGE" >/dev/null 2>&1; then
        local addr
        addr=$(ip -4 -o addr show dev "$SBX_BRIDGE" | awk '{print $4}' | head -1)
        echo "bridge $SBX_BRIDGE: up ($addr)"
    else
        echo "bridge $SBX_BRIDGE: not present (sandbox network not created yet)"
    fi
    check_iptables_path || rc=5
    return $rc
}

check() {
    local image=${HM_NFT_CHECK_IMAGE:-}
    if [ "${1:-}" = --docker ]; then
        image=${2:-}
        [ -n "$image" ] || die "check --docker needs an image that has nft (for example the sandbox image)"
    fi
    if [ -z "$image" ] && [ "$(id -u)" = 0 ] && command -v nft >/dev/null; then
        render | nft -c -f -
        echo "ruleset OK (nft -c, host)"
        return
    fi
    [ -n "$image" ] || die "not root: pass --docker IMAGE to validate inside a throwaway container"
    # Own network namespace (--network none): nothing on the host is touched.
    render | docker run --rm -i --entrypoint "" --network none --cap-drop ALL --cap-add NET_ADMIN \
        --security-opt no-new-privileges:true "$image" nft -c -f -
    echo "ruleset OK (nft -c in $image, private netns)"
}

cmd=${1:-}
shift || true
load_conf
case "$cmd" in
    apply) apply ;;
    ensure) ensure ;;
    remove) remove ;;
    status) status ;;
    render) render ;;
    check) check "$@" ;;
    *) echo "usage: $0 apply|ensure|remove|status|render|check [--docker IMAGE]" >&2; exit 2 ;;
esac
