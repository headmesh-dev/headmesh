# Variables `headmesh-sandbox up` sets for `docker compose`. You only need this
# file to run `docker compose config` by hand. Never put secret values here:
# the CLI reads them from ${root}/secrets/<name> and passes them as HM_SECRET_*.
HEADMESH_SANDBOX_IMAGE=ghcr.io/headmesh-dev/sandbox:0.1.0
HEADMESH_YOLO_EXPIRES_AT=
HM_SECRET_TS_AUTHKEY=
HM_SECRET_GITHUB_TOKEN=
HM_SECRET_CLAUDE_ENV_SECRET=
HM_SECRET_OPENAI_TUNNEL_KEY=
