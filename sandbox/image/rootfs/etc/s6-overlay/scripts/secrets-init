#!/bin/bash
# secrets-init (oneshot, root; plan §6.7, contract "Secrets").
# Compose copies env-sourced secrets to /run/secrets/<name> as root:root 0400.
# Make per-user copies for consumers that don't run as root, write the git
# identity/mode includes, the runtime.env for login shells, and the runtime dirs.
set -euo pipefail
HM_SVC=secrets-init
# shellcheck source=lib.sh
. /etc/s6-overlay/scripts/lib.sh

install -d -m 0755 -o root -g root "$HM_STATE_DIR"
install -d -m 0711 -o root -g root /run/hm-secrets
# State files for services that run unprivileged (written in place, see lib.sh).
hm_put_file /dev/null "$HM_STATE_DIR/claude-rc.json" 0644 agent
install -d -m 0755 -o root -g root /run/hm-git

copy_secret() { # name owner
	local src=/run/secrets/$1 dst=/run/hm-secrets/$1
	if [[ -s $src ]]; then
		hm_put_file "$src" "$dst" 0400 "$2"
	else
		rm -f "$dst"
	fi
}
copy_secret github_token agent
copy_secret github_ssh_key agent
copy_secret openai_tunnel_key hmtunnel

# Runtime directories. Bind-mounted host directories already belong to UID 1000;
# only fix ownership when the directory came from the image or was just created.
for dir in /run/headmesh /var/log/headmesh /var/lib/headmesh/sessions \
	/var/lib/headmesh/artifacts /srv/runner-work /home/agent; do
	mkdir -p "$dir"
	if [[ $(stat -c %u "$dir") == 0 ]]; then chown agent:agent "$dir"; fi
done
mkdir -p /srv/runner /run/tailscale
for dir in /home/agent/.claude /home/agent/.codex; do
	if [[ ! -e $dir ]]; then hm_owned_dir "$dir" 0700 agent; fi
done

# Git identity and mode-specific remotes (included from /etc/gitconfig).
{
	echo "# Written by secrets-init from sandbox.toml [git]."
	if [[ -n ${HEADMESH_GIT_USER_NAME:-} || -n ${HEADMESH_GIT_USER_EMAIL:-} ]]; then
		echo "[user]"
		[[ -n ${HEADMESH_GIT_USER_NAME:-} ]] && printf '\tname = %s\n' "$HEADMESH_GIT_USER_NAME"
		[[ -n ${HEADMESH_GIT_USER_EMAIL:-} ]] && printf '\temail = %s\n' "$HEADMESH_GIT_USER_EMAIL"
	fi
} >/run/hm-git/identity.gitconfig
if [[ ${HEADMESH_MODE:-regular} == yolo ]]; then
	cat >/run/hm-git/mode.gitconfig <<'GIT'
# YOLO: GitHub over SSH with the dedicated deploy key (plan §6.9).
[core]
	sshCommand = ssh -i /run/hm-secrets/github_ssh_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes
GIT
else
	cat >/run/hm-git/mode.gitconfig <<'GIT'
# Regular: GitHub over HTTPS with the fine-grained token (plan §6.9).
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
GIT
fi
chmod 0644 /run/hm-git/*.gitconfig

# Environment for login shells (Tailscale SSH doesn't pass the container env).
{
	for var in HEADMESH_MODE HEADMESH_YOLO_EXPIRES_AT HEADMESH_ENTRYPOINTS HEADMESH_GPU \
		HEADMESH_REPO_LOCK TS_HOSTNAME TZ; do
		printf 'export %s=%q\n' "$var" "${!var:-}"
	done
} >"$HM_STATE_DIR/runtime.env"
chmod 0644 "$HM_STATE_DIR/runtime.env"
if [[ ${HEADMESH_MODE:-regular} == yolo ]]; then
	printf '[YOLO] ' >"$HM_STATE_DIR/mode-label"
else
	: >"$HM_STATE_DIR/mode-label"
fi
chmod 0644 "$HM_STATE_DIR/mode-label"

hm_log "ready (mode=${HEADMESH_MODE:-regular})"
