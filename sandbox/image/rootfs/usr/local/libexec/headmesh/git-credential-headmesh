#!/bin/sh
# Git credential helper: serves the fine-grained GitHub token (plan §6.9) to git
# over HTTPS. secrets-init copies the token to /run/hm-secrets/github_token
# (agent 0400). Only `get` for github.com is answered; store/erase are no-ops.
[ "$1" = get ] || exit 0
token_file=/run/hm-secrets/github_token
[ -r "$token_file" ] || exit 0
host=
while IFS='=' read -r key value; do
	[ -z "$key" ] && break
	[ "$key" = host ] && host=$value
done
[ "$host" = github.com ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
