{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headmesh.dev/schemas/sandbox.schema.json",
  "title": "Headmesh agent sandbox configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "root", "host_home", "image", "agent", "git", "tailnet", "mounts", "mode"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/hostname" },
    "root": { "$ref": "#/$defs/abspath" },
    "host_home": { "$ref": "#/$defs/abspath" },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9.\\-/:]+(@sha256:[a-f0-9]{64})?$",
      "description": "Image reference, optionally pinned by digest."
    },
    "timezone": { "type": "string", "minLength": 1, "default": "America/Toronto" },
    "gpu": { "enum": ["off", "shared"], "default": "off" },
    "repo_lock": { "enum": ["off", "advisory", "enforce"], "default": "advisory" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "gid"],
      "properties": {
        "uid": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "gid": { "type": "integer", "minimum": 1, "maximum": 65534 }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_name", "user_email"],
      "properties": {
        "user_name": { "type": "string", "minLength": 1 },
        "user_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }
      }
    },
    "tailnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login_server", "magicdns_suffix"],
      "properties": {
        "login_server": { "type": "string", "pattern": "^https://" },
        "magicdns_suffix": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "dns_check_name": { "type": "string", "pattern": "^[a-z0-9.-]*$" },
        "dns_check_ip": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": { "type": "string", "pattern": "^[0-9]+[kmg]?$" },
        "cpus": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "mounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rw": { "$ref": "#/$defs/pathlist" },
        "ro": { "$ref": "#/$defs/pathlist" },
        "masks": { "$ref": "#/$defs/pathlist" },
        "allow_secrets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "extra_denylist": { "type": "array", "items": { "type": "string", "pattern": "^(/|~/)" }, "uniqueItems": true }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular", "yolo"],
      "properties": {
        "regular": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "tags"],
          "properties": {
            "hostname": { "$ref": "#/$defs/hostname" },
            "tags": { "$ref": "#/$defs/tags" },
            "reach": { "type": "array", "items": { "$ref": "#/$defs/hostport" }, "uniqueItems": true },
            "rw": { "$ref": "#/$defs/pathlist" },
            "ro": { "$ref": "#/$defs/pathlist" }
          }
        },
        "yolo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "tags"],
          "properties": {
            "hostname": { "$ref": "#/$defs/hostname" },
            "tags": { "$ref": "#/$defs/tags" },
            "default_ttl": { "$ref": "#/$defs/duration" },
            "max_ttl": { "$ref": "#/$defs/duration" },
            "rw": { "$ref": "#/$defs/pathlist" },
            "ro": { "$ref": "#/$defs/pathlist" },
            "allow_lan": { "type": "boolean" },
            "backup_max_age": { "$ref": "#/$defs/duration" },
            "ssh_key": { "type": "string", "pattern": "^(/.*)?$" }
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/abspath" }
    },
    "sandboxd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string", "pattern": "^[^\\s]*:[0-9]{1,5}$" },
        "public_url": { "type": "string", "pattern": "^https?://" },
        "allowed_origins": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "max_concurrent_per_client": { "type": "integer", "minimum": 1, "maximum": 256 },
        "rate_per_minute": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "exec_default_timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "exec_max_timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "tunnel_exec_max_timeout_s": { "type": "integer", "minimum": 1, "maximum": 115 },
        "max_response_bytes": { "type": "integer", "minimum": 65536, "maximum": 10485760 },
        "tunnel_max_response_bytes": { "type": "integer", "minimum": 65536, "maximum": 8388608 },
        "redact_output": { "type": "boolean" },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuer": { "type": "string" },
            "jwks_url": { "type": "string" },
            "resource": { "type": "string" },
            "authorization_servers": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude_runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "capacity": { "type": "integer", "minimum": 1, "maximum": 16 },
            "kill_session_after_min": { "type": "integer", "minimum": 0, "maximum": 10080 },
            "configure_git": { "type": "boolean" }
          }
        },
        "claude_rc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "capacity": { "type": "integer", "minimum": 1, "maximum": 32 },
            "spawn": { "enum": ["same-dir", "worktree"] },
            "cwd": { "$ref": "#/$defs/abspath" }
          }
        },
        "openai_tunnel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "tunnel_id": { "type": "string" }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restic_repo": { "$ref": "#/$defs/abspath" },
        "status_file": { "$ref": "#/$defs/abspath" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/$defs/abspath" },
        "file": { "type": "string", "minLength": 1 },
        "dependency_command": { "type": "string" },
        "magicdns_name": { "type": "string" },
        "allowed_target": { "type": "string" },
        "denied_target": { "type": "string" }
      }
    }
  },
  "$defs": {
    "abspath": { "type": "string", "pattern": "^/" },
    "pathlist": { "type": "array", "items": { "$ref": "#/$defs/abspath" }, "uniqueItems": true },
    "hostname": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^tag:[a-z0-9][a-z0-9-]*$" }
    },
    "hostport": { "type": "string", "pattern": "^[A-Za-z0-9.\\-\\[\\]:]+:[0-9]{1,5}$" },
    "duration": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$" }
  }
}
